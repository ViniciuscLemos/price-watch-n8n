# Fill in the ones you want, leave the others empty.

# Discord: channel settings -> Integrations -> Webhooks -> copy url
DISCORD_WEBHOOK_URL=

# Push on your phone: install the ntfy app, subscribe to a topic name only you
# know (anyone with the name can read it) and put the same name here
NTFY_TOPIC=

# WhatsApp through CallMeBot (free, for personal use): send the activation
# message from https://www.callmebot.com/blog/free-api-whatsapp-messages/ and
# paste the key it answers with. Phone with country code, like +5511987654321
WHATSAPP_PHONE=
WHATSAPP_APIKEY=

# Prices in this country's currency
STEAM_COUNTRY=br
