      },
      "id": "b1f0c9a0-0001-4c1e-9a10-000000000003",
      "name": "Check Steam prices",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        100
      ]
    },
    {
      "parameters": {
        "jsCode": "// Nothing on sale -> return no items, so none of the senders run\nconst deals = $input.first().json.deals || [];\nif (!deals.length) return [];\n\nconst money = (cents, currency) =>\n  currency === 'BRL'\n    ? 'R$ ' + (cents / 100).toFixed(2).replace('.', ',')\n    : (cents / 100).toFixed(2) + ' ' + currency;\n\nconst describe = (d) => {\n  // on sale: compare with the full price; a plain price cut: with the last price seen\n  const was = d.discount > 0 ? d.full_price : d.old_price;\n  const off = d.discount > 0 ? `-${d.discount}%, ` : '';\n  // a game under its target with no sale has nothing to compare with\n  const before = was > d.price ? ` (${off}was ${money(was, d.currency)})` : '';\n  const low = d.lowest ? ' Lowest since I started watching.' : '';\n  const target = d.below_target ? ` Under your target of ${money(d.target, d.currency)}.` : '';\n  return `${money(d.price, d.currency)}${before}.${low}${target}`;\n};\n\nconst one = deals[0];\nconst title = deals.length > 1\n  ? `${deals.length} games from the list are cheaper`\n  : one.discount > 0 ? `${one.name} is on sale`\n  : one.below_target ? `${one.name} is under your target`\n  : `${one.name} is cheaper`;\nconst lines = deals.map((d) => `${d.name}: ${describe(d)}`);\n\n// Discord: one card per game with its banner, at most 10 per message\nconst discord = {\n  content: title,\n  embeds: deals.slice(0, 10).map((d) => ({\n    title: d.name,\n    url: d.url,\n    description: describe(d),\n    color: d.lowest ? 0x57f287 : 0x66c0f4,\n    image: d.image ? { url: d.image } : undefined,\n  })),\n};\n\n// phone push (ntfy): short, opens the best deal when tapped\nconst push = {\n  title,\n  message: lines.join('\\n').slice(0, 3900),\n  click: one.url,\n  attach: one.image || undefined,\n  tags: ['video_game'],\n};\n\n// WhatsApp: plain text, *bold* names, links at the end of each line\nlet whatsapp = `*${title}*\\n\\n` + deals.map((d) => `*${d.name}* ${describe(d)}\\n${d.url}`).join('\\n\\n');\nif (whatsapp.length > 1500) whatsapp = whatsapp.slice(0, 1500) + '\\n...';\n\nreturn [{ json: { title, count: deals.length, discord, push, whatsapp } }];\n"
      },
      "id": "b1f0c9a0-0001-4c1e-9a10-000000000004",
      "name": "Write the message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        100
      ]
    },
